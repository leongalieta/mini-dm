# Mini DM - Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=3777
HOST=0.0.0.0

# Instagram / Meta
INSTAGRAM_ACCESS_TOKEN=seu_token_aqui
INSTAGRAM_ACCOUNT=seu_usuario
INSTAGRAM_BUSINESS_ID=seu_business_id
VERIFY_TOKEN=seu_verify_token_do_webhook
IG_USER_ID=seu_ig_user_id

# Senha do painel (opcional — se não definir, o painel fica aberto)
PANEL_USER=admin
PANEL_PASSWORD=sua_senha_aqui

# Agente de IA
AI_PROVIDER=gemini
AI_API_KEY=sua_chave_da_api
AI_MODEL=gemini-1.5-flash
AI_SYSTEM_PROMPT=Você é um assistente de atendimento atencioso e profissional. Responda de forma educada e objetiva, em português.
AI_ENABLED=false
AI_AUTO_SEND=false
AI_TEMPERATURE=0.7

# Mini DM
MINI_DM_DATA=./data
MINI_DM_NO_OPEN=1
